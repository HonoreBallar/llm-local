# Clé à envoyer dans chaque requête (Authorization: Bearer ... ou x-api-key: ...)
LLM_API_KEY=sk-local-change-me

# Modèle Ollama (pense à mettre le même dans gateway/litellm.yaml)
LLM_MODEL=gemma3:4b

# 127.0.0.1 = accessible seulement depuis ce PC ; 0.0.0.0 = depuis le réseau local
LLM_BIND=127.0.0.1
LLM_PORT=4000

OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=30m
